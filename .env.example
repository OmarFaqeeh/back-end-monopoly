# Copy this file to .env and fill in the values. NEVER commit .env and never put these keys in the front.
PORT=4000
FRONT_ORIGIN=http://localhost:3000
# Supabase: Project URL and the secret / service_role key (Project Settings -> API Keys).
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=PASTE-THE-SECRET-KEY-HERE
# Optional: set to 1 only when the server runs behind a reverse proxy.
# TRUST_PROXY=1
# Optional (tests / demos): shorten the empty-room timer, in milliseconds (default 120000).
# ROOM_EMPTY_TIMEOUT_MS=120000
