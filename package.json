{
  "name": "deal-rush-back",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint .",
    "check:supabase": "tsx scripts/check-supabase.ts",
    "dev:memory": "tsx scripts/dev-memory.ts",
    "sim": "tsx scripts/simulate.ts",
    "sim:bots": "tsx scripts/simulate-bots.ts",
    "predev": "node scripts/syncShared.mjs",
    "prebuild": "node scripts/syncShared.mjs",
    "pretest": "node scripts/syncShared.mjs",
    "predev:memory": "node scripts/syncShared.mjs",
    "check:shared": "node ../scripts/sync-shared.mjs --check"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "nanoid": "^6.0.2",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
